# SyncAlly backend configuration
APP_ENV=development
DEBUG=true

# PostgreSQL connection used by the API and Alembic.
DATABASE_URL=postgresql+psycopg://syncally:syncally-local-only@localhost:5432/syncally

# At least 32 characters outside development/test.
JWT_SECRET=replace-with-a-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
MAX_ORGANIZATIONS_PER_USER=5

# Temporal connection used by the outbox dispatcher and workflow worker.
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=syncally-deals
OUTBOX_POLL_INTERVAL_SECONDS=2.0
OUTBOX_BATCH_SIZE=25

# PayPal Sandbox app credentials; used only by the payment worker.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Optional Gmail SMTP sender for a real inbox copy of each Sandbox invoice.
# Use a Google App Password (requires 2-Step Verification), not your Gmail password.
GMAIL_SMTP_USERNAME=
GMAIL_APP_PASSWORD=
# Optional verified Gmail alias; defaults to GMAIL_SMTP_USERNAME.
GMAIL_FROM_EMAIL=
