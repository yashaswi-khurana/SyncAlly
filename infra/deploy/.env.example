# Point both DNS names to the VM's public IPv4 address before first startup.
APP_DOMAIN=syncally.example.com
TEMPORAL_DOMAIN=temporal.example.com

# Set each secret to a separate value from: openssl rand -hex 32
POSTGRES_ADMIN_PASSWORD=replace_with_a_random_hex_secret
SYNCALLY_DB_PASSWORD=replace_with_a_different_random_hex_secret
TEMPORAL_DB_PASSWORD=replace_with_a_different_random_hex_secret
JWT_SECRET=replace_with_a_different_random_hex_secret

# Temporal is pinned; these image selectors keep the app on supported major lines.
POSTGRES_IMAGE=postgres:16-alpine
TEMPORAL_VERSION=1.32.2

# Optional integrations. Keep AI offline and payments in PayPal Sandbox by default.
AI_PROVIDER=offline
OPENAI_API_KEY=
OPENAI_MODEL=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
GMAIL_SMTP_USERNAME=
GMAIL_APP_PASSWORD=
GMAIL_FROM_EMAIL=
