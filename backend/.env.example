# SyncAlly backend configuration
APP_ENV=development
DEBUG=true

# In development/test, localhost works for same-machine invite testing.
# Deployed environments require your public HTTPS app URL; localhost is rejected there.
PUBLIC_FRONTEND_URL=http://localhost:5173

# PostgreSQL connection used by the API and Alembic.
DATABASE_URL=postgresql+psycopg://syncally:syncally-local-only@localhost:5432/syncally

# At least 32 characters outside development/test.
JWT_SECRET=replace-with-a-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
MAX_ORGANIZATIONS_PER_USER=5

# Temporal connection used by the outbox dispatcher and workflow worker.
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=syncally-deals
OUTBOX_POLL_INTERVAL_SECONDS=2.0
OUTBOX_BATCH_SIZE=25

# AI suggestions use the deterministic offline provider unless explicitly enabled.
# To use OpenAI, set AI_PROVIDER=openai, enable remote egress, select an available
# model for your account, and store the API key in this environment file/secret store.
# To use Gemini, set AI_PROVIDER=gemini, GEMINI_MODEL, and GOOGLE_API_KEY instead.
# Use Google's paid service for deal data; free-tier prompts may be used to improve products.
# Remote calls send shareable deal content only by default; private egress needs
# both flags and the selected organization's UUID in the allowlist.
AI_PROVIDER=offline
AI_REMOTE_EGRESS_ENABLED=false
AI_REMOTE_ALLOW_PRIVATE=false
AI_REMOTE_PRIVATE_ORGANIZATION_IDS=[]
OPENAI_MODEL=
OPENAI_API_KEY=
GEMINI_MODEL=
GOOGLE_API_KEY=

# Selects NEW intents only. OFFLINE_DEMO is restricted to development/test.
# Workers route each intent by its persisted mode; there is no payment fallback.
PAYMENT_MODE=PAYPAL_SANDBOX

# PayPal Sandbox app credentials; used by webhook signature verification and payment processing.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook ID from the same Sandbox REST app, subscribed to the invoicing events.
PAYPAL_WEBHOOK_ID=

# Slack OAuth app settings. Register /integrations/slack/oauth/callback as the redirect URL.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INTEGRATION_TOKEN_ENCRYPTION_KEY=

# Gmail SMTP sender for organization, team-member, deal invitations, and invoice notices.
# Use a Google App Password (requires 2-Step Verification), not your Gmail password.
GMAIL_SMTP_USERNAME=
GMAIL_APP_PASSWORD=
# Optional verified Gmail alias; defaults to GMAIL_SMTP_USERNAME.
GMAIL_FROM_EMAIL=
