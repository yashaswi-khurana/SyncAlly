# SyncAlly backend configuration
APP_ENV=development
DEBUG=true

# PostgreSQL connection used by the API and Alembic.
DATABASE_URL=postgresql+psycopg://localhost:5432/syncally

# At least 32 characters outside development/test.
JWT_SECRET=replace-with-a-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# Retries of an already-rotated refresh token within this window are idempotent.
REFRESH_TOKEN_REUSE_GRACE_SECONDS=30
